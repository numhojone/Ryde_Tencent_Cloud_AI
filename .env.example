# ===== RydeResolve configuration =====
# llm            = use a real OpenAI-compatible model (needs LLM_API_KEY below)
# deterministic  = scripted fallback, no key needed (the demo always runs)
LLM_MODE=deterministic

# Any OpenAI-compatible endpoint works. Default: Google AI Studio (Gemini).
#   Get a key: https://aistudio.google.com/apikey   (never commit it)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# Tencent Hunyuan also works (OpenAI-compatible):
#   LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
#   LLM_MODEL=hunyuan-turbos-latest
# The legacy names HUNYUAN_API_KEY / HUNYUAN_BASE_URL / HUNYUAN_MODEL are still read as aliases.

# Reasoning limits and escalation
LLM_MAX_ITERATIONS=14
LLM_TEMPERATURE=0.2
ESCALATION_THRESHOLD=0.6

# Demo login: secret that signs the session cookie. Put a long random value in your own .env
# (e.g. python -c "import secrets; print(secrets.token_hex(32))"). Never commit a real one.
SECRET_KEY=change_me
# Demo only: the Rider | Driver toggle in the rider pane switches the session role (true for the hackathon build).
DEMO_ROLE_SWITCH=true
# Seconds "Ryde Support is typing" shows before a question reaches the rider or driver (demo pacing).
DEMO_TYPING_DELAY=0.8

# Server
HOST=0.0.0.0
PORT=8000
