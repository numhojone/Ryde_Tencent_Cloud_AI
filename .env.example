# ===== RydeResolve configuration =====
# llm            = use a real OpenAI-compatible model (needs LLM_API_KEY below)
# deterministic  = scripted fallback, no key needed (the demo always runs)
LLM_MODE=deterministic

# Any OpenAI-compatible endpoint works. Default: Google AI Studio (Gemini).
#   Get a key: https://aistudio.google.com/apikey   (never commit it)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# Tencent Hunyuan also works (OpenAI-compatible):
#   LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
#   LLM_MODEL=hunyuan-turbos-latest
# The legacy names HUNYUAN_API_KEY / HUNYUAN_BASE_URL / HUNYUAN_MODEL are still read as aliases.

# Reasoning limits and escalation
LLM_MAX_ITERATIONS=14
LLM_TEMPERATURE=0.2
ESCALATION_THRESHOLD=0.6

# Server
HOST=0.0.0.0
PORT=8000
